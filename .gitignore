# Session-local Claude Code permission grants (machine-specific, not shared)
.claude/settings.local.json

# External scientific codebases (MCFM, Pepper) are tracked as git submodules under
# software/ — see software/README.md. Their contents live in the submodule repos,
# so nothing to ignore here.

# Deterministic caches produced by tools/ against the clones (index, roadmap, drafts).
/tools/assets/
*.tsv
*.scribe

# Python / editor cruft
__pycache__/
*.pyc
.venv/
.DS_Store
